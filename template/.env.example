# ─────────────────────────────────────────────────────────────────────────────
# AUTH BOILERPLATE — Environment Variables
#
# Copy this file to .env and fill in real values.
# Every variable marked REQUIRED will cause the server to crash on startup
# if missing. The server will not start without a valid .env file.
#
# For production (Coolify), set these in the platform's environment UI.
# These variables are NOT needed at build time — prisma.config.ts avoids
# importing the env validator so migrations work without secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core ─────────────────────────────────────────────────────────────────────
# Environment: "development" or "production"
# Controls cookie security flags, error detail exposure, and more.
NODE_ENV=development

# HTTP server port
PORT=5000

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/{{PROJECT_NAME}}

# ─── better-auth ──────────────────────────────────────────────────────────────
# Generate a secure random secret: openssl rand -hex 32
# Used to sign session cookies. MUST be different per deployment.
BETTER_AUTH_SECRET=your-random-secret-here

# Public base URL of this API (http in dev, https in prod)
# This is the URL clients use to reach this backend.
BETTER_AUTH_URL=http://localhost:5000

# Public URL of the frontend SPA (used for OAuth redirect URLs and CORS)
FRONTEND_URL=http://localhost:5173

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Used for OTP email delivery (password reset, email verification).
# Gmail: App Password required (not your regular password).
# See: https://support.google.com/accounts/answer/185833
EMAIL_SENDER_SMTP_USER=your-email@gmail.com
EMAIL_SENDER_SMTP_PASS=your-app-password
EMAIL_SENDER_SMTP_HOST=smtp.gmail.com
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_FROM=your-email@gmail.com

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create a Google Cloud project → Enable Google+ API → Create OAuth 2.0 credentials.
# Both values must be set together; leaving one empty disables Google sign-in.
# Authorized JavaScript origins should include FRONTEND_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Cloudinary (file uploads) ────────────────────────────────────────────────
# Sign up at https://cloudinary.com and get credentials from the dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=boilerplate-uploads

# ─── Redis (optional — for caching and rate limiting) ─────────────────────────
# If unset, the app falls back to localhost:6379 with no password.
REDIS_URL=redis://localhost:6379

# ─── Super Admin (seeded automatically on first boot) ─────────────────────────
# A super admin account is created if none exists.
# SUPER_ADMIN_PASSWORD is auto-generated if omitted — check server logs.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=
